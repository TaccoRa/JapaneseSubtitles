<div class="card2-front_margin">
  {{#Back}}
    <span class="transl card-question-text">{{Back}}</span>
  {{/Back}}

  {{#SentenceDE}}
    <span class="sentenceDE card-question-text">{{SentenceDE}}</span>
  {{/SentenceDE}}

  {{#Image}}
    <div class="card-question-image">{{Image}}</div>
  {{/Image}}
</div>

<script>
(function () {
  function px(value) {
    const n = parseFloat(value);
    return Number.isFinite(n) ? n : 0;
  }

  function outerHeight(el) {
    if (!el) return 0;
    const rect = el.getBoundingClientRect();
    const style = getComputedStyle(el);
    return rect.height + px(style.marginTop) + px(style.marginBottom);
  }

  function viewportHeight() {
    const visual = window.visualViewport && window.visualViewport.height;
    return visual || window.innerHeight || document.documentElement.clientHeight || 0;
  }

  function fitQuestionImage() {
    // Once the answer exists, its Japanese content gets its own priority-based fit.
    if (document.getElementById("answer")) return;

    const card = document.querySelector(".card");
    const question = document.querySelector(".card2-front_margin");
    const imageBox = question && question.querySelector(".card-question-image");
    if (!card || !question || !imageBox) return;

    card.classList.remove("has-answer");
    question.style.minWidth = "";
    const questionStyle = getComputedStyle(question);
    let fixedHeight = px(questionStyle.paddingTop) + px(questionStyle.paddingBottom);
    Array.from(question.children).forEach(function (child) {
      if (child !== imageBox) fixedHeight += outerHeight(child);
    });

    const cardStyle = getComputedStyle(card);
    const minTile = Math.max(1, px(cardStyle.getPropertyValue("--stroke-tile-min")) || 80);
    const maxTile = Math.max(minTile, px(cardStyle.getPropertyValue("--stroke-tile-max")) || 160);
    const availableHeight = Math.max(0, Math.floor(
      (card.clientHeight || viewportHeight()) - fixedHeight
    ));
    const availableWidth = card.clientWidth || card.getBoundingClientRect().width || maxTile * 2;
    // A reverse question has no visible stroke row yet, so use the largest
    // possible two-column grid (two tiles wide) as its visual cap.
    const imageSize = Math.max(minTile, Math.floor(Math.min(
      maxTile * 2,
      availableHeight,
      availableWidth
    )));
    imageBox.style.width = imageSize + "px";
    imageBox.style.height = imageSize + "px";
    imageBox.style.flex = "0 0 " + imageSize + "px";
  }

  function scheduleQuestionImageFit() {
    requestAnimationFrame(function () {
      fitQuestionImage();
      requestAnimationFrame(fitQuestionImage);
    });
  }

  window.__backToFrontQuestionImageFit = scheduleQuestionImageFit;

  document.querySelectorAll(".card-question-image img").forEach(function (image) {
    image.addEventListener("load", scheduleQuestionImageFit);
  });

  if (typeof onUpdateHook !== "undefined") onUpdateHook.push(scheduleQuestionImageFit);
  if (typeof onShownHook !== "undefined") onShownHook.push(scheduleQuestionImageFit);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleQuestionImageFit);
  } else {
    scheduleQuestionImageFit();
  }
  setTimeout(scheduleQuestionImageFit, 0);

  if (!window.__backToFrontQuestionImageFitBound) {
    window.__backToFrontQuestionImageFitBound = true;
    const refit = function () {
      if (typeof window.__backToFrontQuestionImageFit === "function") {
        window.__backToFrontQuestionImageFit();
      }
    };
    window.addEventListener("resize", refit);
    window.addEventListener("orientationchange", refit);
  }
})();
</script>
















