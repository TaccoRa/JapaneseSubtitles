<!-- ===== STYLING ===== -->
.card {
  font-family: arial;
  font-size: 35px;
  text-align: center;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  height: 100dvh;
  margin: 0;
  display: flex;
  flex-direction: column;
  overflow-x: auto;
  overflow-y: auto;
}

/* CARD 1: Front -> Back. Change only these four values for this direction. */
.card1 {
  --stroke-tile-min: 80px;
  --stroke-tile-max: 160px;
  --card-image-min: 120px;
  --card-image-max: 640px;
}

/* CARD 2: Back -> Front. Change only these four values for this direction. */
.card2 {
  --stroke-tile-min: 70px;
  --stroke-tile-max: 130px;
  --card-image-min: 100px;
  --card-image-max: 360px;
}

.answer-scroll-anchor {
  display: block;
  flex: 0 0 auto;
  height: 0;
  overflow: hidden;
}

.answer-divider {
  flex: 0 0 auto;
}

.anki-card-image {
  display: flex;
  flex: 0 0 var(--card-image-min);
  width: var(--card-image-min);
  height: var(--card-image-min);
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0.5em auto;
}

.anki-card-image img {
  display: block;
  width: 100% !important;
  height: 100% !important;
  max-width: 100% !important;
  max-height: 100% !important;
  object-fit: contain;
}

.card2-front_margin {
  padding-top: 1em;
  box-sizing: border-box;
  width: 100%;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-question-text {
  display: block;
  flex: 0 0 auto;
}

.kanji {
  display: block;
  flex: 0 0 auto;
  font-size: 1.6em;
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
  min-height: 1.15em;
}

.kanji .sound {
  display: inline-block;
  font-size: 0.55em;
  line-height: 1;
  vertical-align: middle;
}

.sentenceJA {
  display: block;
  flex: 0 0 auto;
  width: 100%;
  box-sizing: border-box;
  font-size: 0.9em;
  line-height: 1.25;
  color: black;
}

.sentenceDE { font-size: 0.8em; color: black }

.night_mode .sentenceJA,
.night_mode .sentenceDE,
.nightMode .sentenceJA,
.nightMode .sentenceDE {
  color: white;
}

ruby rt {
  visibility: hidden;
  opacity: 0;
  font-size: 0.55em;
  transition: opacity 0.5s ease;
  line-height: 0.5;
}

ruby.show rt {
  visibility: visible;
  opacity: 1;
}

ruby {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.highlight {
  color: #ffcc33;
  font-weight: bold;
}

ruby:has(.highlight) rt {
  color: #ffcc33;
  font-weight: 700;
}

.kanji .highlight { 
  color: inherit; 
  background: none; 
  padding: 0; 
  border-radius: 0; 
}


.stroke-order-row {
  --stroke-cols: 2;
  --stroke-size: var(--stroke-tile-max);
  flex: 0 0 auto;
  width: 100%;
  max-width: 100%;
  min-height: 0;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(var(--stroke-cols), var(--stroke-size));
  grid-auto-rows: var(--stroke-size);
  gap: 0;
  justify-content: center;
  align-content: center;
  justify-items: center;
  align-items: center;
  overflow: visible;
  margin: 0.5em 0;
}

.stroke-order-media {

  width: var(--stroke-size);
  height: var(--stroke-size);
  aspect-ratio: 1 / 1;

  overflow: hidden;
  transform: translateZ(0);
  backface-visibility: hidden;
  contain: paint;
  -webkit-tap-highlight-color: transparent;

  --stroke-speed: 2.0;
  --stroke-gap: 0;
  --stroke-brush: 1;
  --stroke-backward: 0;
  --stroke-autoplay: 0;
  --stroke-idle-final: 1;

  --stroke-bg: #52514f;
  --stroke-line: #060503;
  --stroke-brush-fill: #e53935;
  --stroke-brush-stroke: #555;

  --stroke-grid: 1;
  --stroke-grid-color: #50463a;
  --stroke-grid-width: 2;
  --stroke-grid-border-width: 2;
  --stroke-grid-border-color: #50463a;
  --stroke-grid-dash: 3 2;
  --stroke-grid-center-hole: 2;
  --stroke-grid-opacity: 1;

  position: relative;
}

.stroke-order-row > .stroke-order-media:last-child:nth-child(odd):not(:only-child) {
  grid-column: 1 / -1;
  justify-self: center;
}
